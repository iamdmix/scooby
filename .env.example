# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ID=your-tunnel-id
CLOUDFLARE_CREDENTIALS_FILE=/path/to/.cloudflared/your-tunnel-id.json

# Domain
DOMAIN=yourdomain.tech

# Ports
JELLYFIN_PORT=8096
PORTFOLIO_PORT=8081
PORTAINER_PORT=9000
UPTIME_KUMA_PORT=3001

# Media path
MEDIA_PATH=~/Media

# Pi-hole (set a real password)
PIHOLE_WEBPASSWORD=change-me

# Homepage widget keys (generate real tokens, keep these secret)
HOMEPAGE_VAR_PIHOLE_KEY=your-pihole-token
HOMEPAGE_VAR_PORTAINER_API_KEY=ptr_your-portainer-access-token
HOMEPAGE_VAR_JELLYFIN_API_KEY=your-jellyfin-api-key
